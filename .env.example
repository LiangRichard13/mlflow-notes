# MLflow Learning - API Key 模板
# =====================================
# 复制为 .env（注意带点）然后填入真实 key。.env 已加到 .gitignore
#
# ⚠️ Phase 5 开始需要 LLM API key
# 推荐选【国内服务商】（按推荐度排序），最后才是 OpenAI/Anthropic

# ============================================================
# 【推荐】国内服务商（OpenAI 协议兼容，MLflow 直接支持）
# ============================================================

# ---------- DeepSeek（首选，性价比之王）----------
# 官网：https://platform.deepseek.com/
# 注册 → API Keys → 创建
# 模型：deepseek-chat（V3，便宜）、deepseek-reasoner（R1，思考模式）
# 文档：https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key
# OPENAI_API_BASE=https://api.deepseek.com/v1

# ---------- 智谱 GLM（清华系，OpenAI 协议）----------
# 官网：https://bigmodel.cn/
# 注册 → 个人中心 → API Keys
# 模型：glm-4-flash（免费！）、glm-4-plus、glm-4-air
# 文档：https://bigmodel.cn/dev/api/normal-model/glm-4
ZHIPU_API_KEY=your-zhipu-key
# OPENAI_API_BASE=https://open.bigmodel.cn/api/paas/v4/

# ---------- 阿里云百炼（DashScope / Qwen）----------
# 官网：https://bailian.console.aliyun.com/
# 注册 → API-KEY 管理 → 创建
# 模型：qwen-turbo（便宜）、qwen-plus、qwen-max、qwen-long
# 文档：https://help.aliyun.com/zh/model-studio
DASHSCOPE_API_KEY=sk-your-dashscope-key
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- Moonshot / Kimi（月之暗面）----------
# 官网：https://platform.moonshot.cn/
# 注册 → API Keys
# 模型：moonshot-v1-8k / -32k / -128k
MOONSHOT_API_KEY=sk-your-moonshot-key
# OPENAI_API_BASE=https://api.moonshot.cn/v1

# ---------- 零一万物 ----------
# 官网：https://platform.lingyiwanwu.com/
# 模型：yi-large / yi-medium
YI_API_KEY=your-yi-key
# OPENAI_API_BASE=https://api.lingyiwanwu.com/v1

# ============================================================
# 【可选】海外服务商
# ============================================================

# ---------- OpenAI ----------
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_API_BASE=https://api.openai.com/v1
# 模型：gpt-4o-mini（便宜）、gpt-4o、gpt-4-turbo

# ---------- Anthropic Claude ----------
# 官网：https://console.anthropic.com/
# 模型：claude-haiku-4-5（便宜）、claude-sonnet、claude-opus
# ⚠️ Anthropic 的 API 不是 OpenAI 协议，MLflow 用 mlflow.anthropic.autolog()
# ANTHROPIC_API_KEY=sk-ant-your-key

# ============================================================
# Phase 5+ 会用到的环境变量（MLflow autolog 自动读）
# ============================================================

# MLflow 默认读 OPENAI_API_KEY 和 ANTHROPIC_API_KEY
# 如果你用国内服务商（DeepSeek/智谱/百炼/Moonshot），需要：
# 1. 设置对应的 API key（如 DEEPSEEK_API_KEY）
# 2. 把 OPENAI_API_KEY 也设上 = 你的 deepseek key（MLflow 默认认这个名）
# 3. 设 OPENAI_API_BASE 指向对应端点
# 我们的代码会用 python-dotenv 自动加载，详见 04_tracing/05a_env_setup.py